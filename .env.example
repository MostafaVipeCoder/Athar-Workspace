# Replace this with your actual Google Apps Script Web App URL after deployment
GOOGLE_APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/.../exec

# Sub-path where the app is deployed (used to build correct public share links)
# Example: if the app is at https://athareg.com/EventsOperations/ → set to /EventsOperations
# Leave empty or remove this line for root deployments (https://example.com/)
VITE_BASE_PATH=/EventsOperations
