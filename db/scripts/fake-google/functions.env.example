# Names only: copy to local-db/functions.env (git-ignored) and fill the values on your machine. NEVER commit real values, never paste them in chat.
# Read by `supabase functions serve --env-file local-db/functions.env` (supabase-new/functions/google-oauth-*, google-disconnect and, later, email-worker / calendar-sync).

# --- required -------------------------------------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# must equal the Authorised redirect URI of the OAuth client, character for character
GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/google-oauth-callback
# where the browser goes after Google (npm run dev:local serves http://127.0.0.1:5174; the app's base path, when it has one, is part of it)
APP_URL=http://127.0.0.1:5174
# >= 32 random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OAUTH_STATE_SECRET=

# --- token storage ----------------------------------------------------------------------------------------------------------------
# 'auto' = Supabase Vault when the database has it (the local image does), else AES-256-GCM with TOKEN_ENC_KEY. 'vault' | 'aes' force one.
TOKEN_STORAGE=auto
# 64 hex characters (spare on the local image, REQUIRED where Vault is missing):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy in the password manager. For a rotation put the old key in TOKEN_ENC_KEY_OLD (decrypt only).
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_OLD=

# --- policy (defaults shown) ----------------------------------------------------------------------------------------------------
ALLOWED_GOOGLE_DOMAIN=athareg.com
SYSTEM_SENDER_EMAIL=startups@athareg.com
# same_email = the connected Google account must have the same e-mail as the platform login (closes account linking); same_domain = any @athareg.com account
GOOGLE_PM_EMAIL_POLICY=same_email
# comma separated origins allowed to call google-oauth-start / google-disconnect from a browser (default: the origin of APP_URL)
# ALLOWED_ORIGINS=http://127.0.0.1:5174

# --- e-mail worker (m62, supabase-new/functions/email-worker/README.md) -------------------------------------------------------------
# >= 24 random characters, shared between the database (app_private.email_worker_enable stores it in Vault) and the function:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_WORKER_SECRET=
# optional ceilings (a request can only go below them): messages a minute per sender (Gmail allows about 60), messages a day per sender (Google: 2,000), seconds per run
# EMAIL_PER_MINUTE=30
# EMAIL_DAILY_CAP=1500
# EMAIL_MAX_RUN_SECONDS=100

# --- TEST ONLY: talk to the fake Google (db/scripts/fake-google). DELETE these five lines to use the real Google -----------------
# The functions refuse any GOOGLE_* address override unless ALLOW_FAKE_GOOGLE=1.
# ALLOW_FAKE_GOOGLE=1
# GOOGLE_AUTH_BASE=http://127.0.0.1:54399
# GOOGLE_TOKEN_URL=http://host.docker.internal:54399/token
# GOOGLE_REVOKE_URL=http://host.docker.internal:54399/revoke
# GOOGLE_API_BASE=http://host.docker.internal:54399
# (GOOGLE_AUTH_BASE is opened by the BROWSER, the other three by the function inside the edge-runtime container: pick the host each can reach.)
